<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.danilonovais.macbook-daily-care</string>
  <key>ProgramArguments</key>
  <array><string>__PYTHON__</string><string>__SCRIPT__</string><string>--mode</string><string>audit</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key><dict><key>TZ</key><string>America/Sao_Paulo</string></dict>
  <key>StandardOutPath</key><string>__LOG_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/launchd.err.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
