# macOS-Use runtime configuration. Copy to .env and add only the provider key you use.
ANONYMIZED_TELEMETRY=false
MACOS_USE_PROFILE=observe
MACOS_USE_PROVIDER=ollama
MACOS_USE_MODEL=qwen3.6:latest
MACOS_USE_BROWSER=safari
MACOS_USE_MAX_STEPS=12
MACOS_USE_MAX_FAILURES=2
MACOS_USE_USE_VISION=false
MACOS_USE_THINKING=false
MACOS_USE_LOG_TO_FILE=false

# Provider credentials (leave unused entries empty in your local .env).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_NIM_API_KEY=
